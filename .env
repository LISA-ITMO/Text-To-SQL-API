
# Database configuration

DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=upgo_test_02
DB_USER=postgres
DB_PASSWORD=12345

#Нстройки для LLM сервера
LLM_SERVER = http://26.34.168.79:8080/v1/
LLM_API_KEY = None
LLM_MODEL_NAME = NoName

# Qdrant vector database

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=upgo_database_schema
QDRANT_BACKUP_DIR=vector_db_backups
QDRANT_BATCH_SIZE=50
QDRANT_SCORE_THRESHOLD=0.10
QDRANT_SEARCH_LIMIT=30


# Embeddings model

EMBEDDINGS_MODEL_NAME=intfloat/multilingual-e5-large-instruct
EMBEDDINGS_DIMENSION=1024


# RAG general settings

RAG_ANSWER_LIMIT_TABLES=5
RAG_MAX_PREDICTED_TABLES=3
RAG_MAX_PREDICTED_COLUMNS=3
RAG_USE_LEMMATIZER=true
RAG_STOP_WORDS=и,в,во,не,что,он,на,я,с,со,как,а,то,все,она,так,его,но,да,ты,к,у,же,вы,за,бы,по,только,ее,мне,было,вот,от,меня,еще,нет,о,из,ему,теперь,когда,даже,ну,вдруг,ли,если,уже,или,ни,быть,был,него,до,вас,нибудь,опять,уж,вам,ведь,там,потом,себя,ничего,ей,может,они,тут,где,есть,надо,ней,для,мы,тебя,их,чем,была,сам,чтобы,без,будто,чего,раз,тоже,себе,под,будет,ж,тогда,кто,этот,того,потому,этого,какой,совсем,ним,здесь,этом,один,почти,мой,тем,чтобы,нее,сейчас,были,куда,зачем,всех,никогда,можно,при,наконец,два,об,другой,хоть,после,над,больше,тот,через,эти,нас,про,всего,них,какая,много,разве,три,эту,моя,впрочем,хорошо,свою,этой,перед,иногда,лучше,чуть,том,нельзя,такой,им,более,всегда,конечно,всю,между


# RAG relevance weights

RAG_RELEVANCE_WEIGHTS_TABLE_MATCH=2.0
RAG_RELEVANCE_WEIGHTS_COLUMN_MATCH=0.5
RAG_RELEVANCE_WEIGHTS_TERM_MATCH=0.3
RAG_RELEVANCE_WEIGHTS_RUSSIAN_CONTEXT=0.5
RAG_RELEVANCE_WEIGHTS_DOC_TYPE_STRUCTURE=1.0
RAG_RELEVANCE_WEIGHTS_DOC_TYPE_RELATIONS=1.0
RAG_RELEVANCE_WEIGHTS_COLUMN_COUNT_FACTOR=0.1


# RAG keyword patterns (used for question type detection)

RAG_KEYWORD_PATTERNS_STRUCTURE=структура,столбец,колонка,поле,тип данных,описание таблиц
RAG_KEYWORD_PATTERNS_RELATIONS=связь,отношение,ключ,foreign,ссылаться,внешний
RAG_KEYWORD_PATTERNS_COLUMNS=столбец,колонка,поле,атрибут,показатель
RAG_KEYWORD_PATTERNS_DATA_QUERY=вывести,найти,получить,запрос,select,данные,информацию
RAG_KEYWORD_PATTERNS_FIO=фио,фамилия,имя,отчество,ф.и.о.,full name
RAG_KEYWORD_PATTERNS_DATE=дата,период,время,год,месяц,число,срок
RAG_KEYWORD_PATTERNS_APPOINTMENT=назначен,назначение,утвержден,принят,вступил в должность
RAG_KEYWORD_PATTERNS_MANAGER=руководитель,начальник,директор,заведующий,управляющий
RAG_KEYWORD_PATTERNS_ORGANIZATION=организация,подразделение,отдел,департамент,служба
RAG_KEYWORD_PATTERNS_POSITION=должность,позиция,звание,ранг,категория


# RAG table name patterns (regex -> possible table names)

RAG_TABLE_PATTERNS_EMPLOYEE=staff_employee,employee,staff,personnel
RAG_TABLE_PATTERNS_MANAGER=chief,manager,director,head
RAG_TABLE_PATTERNS_ORGANIZATION=organizations_organization,department,division
RAG_TABLE_PATTERNS_POSITION=organizations_position,position,job_title
RAG_TABLE_PATTERNS_STAFFING=staffing_department,staffing,staff_schedule
RAG_TABLE_PATTERNS_ORDER=orders_order,order,appointment_order
RAG_TABLE_PATTERNS_RESERVE=staff_reserveinfo,reserve,personnel_reserve
RAG_TABLE_PATTERNS_AWARD=staff_employeeaward,employee_award,award,reward,honor,decoration,medal


# RAG column name patterns (regex -> possible column names)

RAG_COLUMN_PATTERNS_FIO=last_name,first_name,middle_name,full_name,surname,given_name,patronymic
RAG_COLUMN_PATTERNS_DATE=in_date,appointment_date,order_date,start_date,end_date,created_at,updated_at,effective_date
RAG_COLUMN_PATTERNS_POSITION=position_name,job_title,role_name,title
RAG_COLUMN_PATTERNS_DEPARTMENT=department_name,division_name,unit_name,branch_name,full_path,department_path,org_structure
RAG_COLUMN_PATTERNS_STATUS=status,state,is_active,is_current,appointment_status,employment_status
RAG_COLUMN_PATTERNS_ID=id,employee_id,position_id,department_id,order_id


# Lemmatizer settings

LEMMATIZER_ENABLED=true
LEMMATIZER_ADDITIONAL_STOP_WORDS=


# Logging

LOGGING_LEVEL=INFO
LOGGING_FILE=upgo_rag_system.log
LOGGING_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
